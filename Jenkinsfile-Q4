pipeline {
    agent any
    environment {
        APP_ENV = 'staging'
    }
    stages {
        stage('Build') {
            options {
                retry(3)
            }
            steps {
                sh 'making a build'
            }
        }
        stage('Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'testing'
                }
            }
        }
    }
}
