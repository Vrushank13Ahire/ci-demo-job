pipeline {
    agent any

    stages {
        stage('Checkout') {    // This stage was outside the stages block -- Syntax error
            steps {
                git url: 'https://github.com/Vrushank13Ahire/ci-demo-job.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Installing Dependencies'
                sh 'npm install'
                sh 'npm run build'
            }
        }

        stage('Parallel Tests') {
            parallel {
                stage('Unit Test') {       // Curly Braces errors fixed HERE
                    steps {
                        sh 'npm test'
                    }
                }

                stage('Lint') {
                    steps {
                        sh 'npm run lint'
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'rm -rf workspace/*'
        }
    }
}                                         // One curly bracket was missing here
